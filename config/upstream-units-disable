# Upstream releng enablement symlinks removed from the copied profile by
# scripts/prepare-profile.sh. Paths are relative to airootfs.
#
# NetworkManager replaces systemd-networkd and iwd as the network stack.
# Running both stacks at once causes interface ownership conflicts.
# systemd-resolved is intentionally kept; NetworkManager integrates with it.
/etc/systemd/system/multi-user.target.wants/systemd-networkd.service
/etc/systemd/system/multi-user.target.wants/iwd.service
/etc/systemd/system/network-online.target.wants/systemd-networkd-wait-online.service
/etc/systemd/system/sockets.target.wants/systemd-networkd.socket
/etc/systemd/system/dbus-org.freedesktop.network1.service
